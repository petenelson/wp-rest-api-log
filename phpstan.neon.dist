parameters:
	level: 5
	# Analyze against the minimum PHP version in the plugin header, not the
	# PHP version running PHPStan.
	phpVersion: 70400
	paths:
		- admin
		- includes
		- uninstall.php
		- wp-rest-api-log.php
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-i18n-stubs.php
	bootstrapFiles:
		- tests/phpstan-constants.php
